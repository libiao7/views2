<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_previous_button="false"
        app:show_next_button="false"
        app:show_rewind_button="false"
        app:show_fastforward_button="false"
        app:hide_on_touch="false"
        app:animation_enabled="false"
        app:show_subtitle_button="true"
        app:time_bar_scrubbing_enabled="true"
        android:keepScreenOn="true"
        app:show_timeout="0"
        app:played_color="#00000000"
        app:unplayed_color="#00000000"
        app:buffered_color="#88FFFFFF"
        app:bar_height="100dp"
        app:touch_target_height="100dp"
        app:scrubber_color="#88FF00FF" />

    <com.example.views1.Vr180SbsGlSurfaceView
        android:id="@+id/vr180View"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <Button
        android:id="@+id/vr180Toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="12dp"
        android:elevation="12dp"
        android:text="VR180"
        android:textAllCaps="false" />

</FrameLayout>
